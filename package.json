{
  "name": "marktext-monorepo",
  "description": "LeafBook monorepo root",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/Jacquesxu666/marktext",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "generate-leafbook-icons": "bash scripts/generate-leafbook-icons.sh",
    "verify-leafbook-icons": "bash scripts/verify-leafbook-icons.sh",
    "verify-leafbook-ico": "tsx scripts/verifyLeafBookIco.ts",
    "verify-leafbook-metadata": "tsx scripts/verifyLeafBookMetadata.ts",
    "verify-windows-associations": "tsx scripts/verify-windows-associations.ts",
    "audit:release-files": "bash scripts/audit-release-files.sh",
    "audit:platform-artifacts": "bash scripts/audit-platform-artifacts.sh",
    "audit:mac-artifact": "bash scripts/audit-mac-artifact.sh",
    "audit:mac-unpacked": "bash scripts/audit-mac-unpacked.sh",
    "package:mac:unsigned:dir": "bash scripts/package-mac-unsigned-dir.sh",
    "smoke:mac:unpacked": "bash scripts/smoke-mac-unpacked.sh",
    "rebuild-native": "pnpm --filter leafbook rebuild-native",
    "start": "pnpm --filter leafbook start",
    "dev": "pnpm --filter leafbook dev",
    "build": "pnpm --filter leafbook build",
    "build:unpack": "pnpm --filter leafbook build:unpack",
    "build:win": "pnpm --filter leafbook build:win",
    "build:win:x64": "pnpm --filter leafbook build:win:x64",
    "build:win:arm64": "pnpm --filter leafbook build:win:arm64",
    "build:mac": "pnpm --filter leafbook build:mac",
    "build:mac:x64": "pnpm --filter leafbook build:mac:x64",
    "build:mac:arm64": "pnpm --filter leafbook build:mac:arm64",
    "build:linux": "pnpm --filter leafbook build:linux",
    "build:linux:x64": "pnpm --filter leafbook build:linux:x64",
    "build:linux:arm64": "pnpm --filter leafbook build:linux:arm64",
    "perf:inspect": "pnpm --filter leafbook perf:inspect",
    "perf:inspect-brk": "pnpm --filter leafbook perf:inspect-brk",
    "test": "pnpm --filter leafbook test",
    "test:unit": "pnpm --filter leafbook test:unit",
    "test:e2e": "pnpm --filter leafbook test:e2e",
    "typecheck": "pnpm --filter leafbook typecheck",
    "typecheck:watch": "pnpm --filter leafbook typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "generate:release-sbom": "node scripts/generate-release-sbom.mjs",
    "verify:release-notes": "node scripts/verify-release-notes.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15",
      "esbuild@>=0.27.0 <0.28.1": "0.28.1"
    }
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "electron": "~42.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-vue": "^10.9.2",
    "license-checker": "^25.0.1",
    "neostandard": "^0.13.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vue-eslint-parser": "^10.4.1",
    "yaml": "^2.9.0"
  }
}
